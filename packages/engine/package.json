  },
  "dependencies": {
    "@michelepolo/git-swimlanes-contract": "*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsup": "8.5.1",
    "vitest": "4.1.8"
  }
}
