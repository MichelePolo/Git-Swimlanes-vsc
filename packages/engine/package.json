{
  "name": "@michelepolo/git-swimlanes-engine",
  "version": "0.0.0",
  "description": "Platform-agnostic deterministic Git history visualizer (React component + webview bundle).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
